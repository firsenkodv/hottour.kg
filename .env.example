APP_NAME="HOT TOUR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# На боевом: APP_ENV=production, APP_DEBUG=false, APP_URL=https://hottour.kz

# Сторонние подключения: счётчики, CDN, карты, виджеты, CRM (config/external.php).
# false — не подключать ничего внешнего: страницы перестают ждать недоступные
# домены. Обязательно при разработке под VPN.
# На боевом сервере переменную не задают — там действует true.
EXTERNAL_SERVICES=false

# Точечные переопределения (true — включить сервис вопреки рубильнику):
# EXTERNAL_GTM, EXTERNAL_YANDEX_MAPS, EXTERNAL_TOURVISOR_JS,
# EXTERNAL_TRAVELPAYOUTS, EXTERNAL_TRANSLATE, EXTERNAL_CRM, EXTERNAL_TINYMCE

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hottour
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Только для https-сайта; на локальном http оставить пустым,
# иначе браузер не примет cookie сессии и формы будут отдавать 419
SESSION_SECURE_COOKIE=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------------
# Админка MoonShine
#--------------------------------------------------------------------------
# Префикс адреса админки: admin -> https://hottour.kz/admin
MOONSHINE_ROUTE_PREFIX=admin
MOONSHINE_TITLE="HOT TOUR"

# Ключ TinyMCE (редактор текста в админке). Пусто — редактор работает
# в бесплатном режиме с предупреждением на домене.
TINYMCE_TOKEN=

#--------------------------------------------------------------------------
# API Tourvisor
#--------------------------------------------------------------------------
# Основное место настройки — админка: «Настройки сайта» -> вкладка «Турвизор».
# Заполненное там поле перекрывает переменную отсюда, пустое — оставляет её.
# Эти значения работают как запасные: на новом окружении, пока в админку
# никто не заходил, и на случай, если база недоступна.
#
# Обязательны: без них не работают поиск туров, города вылета и страны.
TOURVISOR_LOGIN=
TOURVISOR_PASSWORD=
TOURVISOR_URL=https://tourvisor.ru/xml/

# Режим работы с API: live | record | replay | auto
#   live   — обычный режим, запрос уходит на tourvisor.ru (боевое значение)
#   record — запрос уходит в сеть, ответ дополнительно пишется в кэш файлов
#   replay — сеть не используется, ответ берётся из кэша
#   auto   — есть файл в кэше, берём оттуда; нет — идём в сеть и записываем
TOURVISOR_MODE=live

# Кэш справочников list.php (города вылета, страны, регионы, отели), секунды
TOURVISOR_LIST_TTL=21600

# Таймаут сетевого запроса к API, секунды
TOURVISOR_TIMEOUT=8

#--------------------------------------------------------------------------
# Почта
#--------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Адрес администратора — уведомления о заявках с форм
MAIL_ADMIN=
# Адрес отдела продаж — заказы туров
MAIL_ZAKAZ=

#--------------------------------------------------------------------------
# Резервные копии (spatie/laravel-backup)
#--------------------------------------------------------------------------
BACKUP_ARCHIVE_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Панель отладки — на боевом только false
DEBUGBAR_ENABLED=false
